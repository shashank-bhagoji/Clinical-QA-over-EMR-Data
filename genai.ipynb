from google.colab import drive
import os

drive.mount('/content/drive', force_remount=True)

data_path = '/content/drive/My Drive/mimic-iii-clinical-database-demo-1.4/'

if os.path.exists(data_path):
    os.chdir(data_path)
    print("Successfully changed directory to:")
    print(os.getcwd())
else:
    print("Error: Path not found.")
    print("Please check your Google Drive folder name.")


# ============================================================
# 3. IMPORT LIBRARIES
# ============================================================

import pandas as pd
import numpy as np
import torch
import faiss
import re
import matplotlib.pyplot as plt

from sentence_transformers import SentenceTransformer

from transformers import (
    AutoTokenizer,
    AutoModelForCausalLM,
    pipeline,
    BitsAndBytesConfig
)

print("All libraries imported successfully.")


# ============================================================
# 4. LOAD CLINICAL DATA
# ============================================================

print("\nLoading clinical datasets...")

files_to_load = {
    "patients": "PATIENTS.csv",
    "admissions": "ADMISSIONS.csv",
    "prescriptions": "PRESCRIPTIONS.csv",
    "diagnoses": "DIAGNOSES_ICD.csv",
    "labevents": "LABEVENTS.csv"
}

data = {}

for key, file_name in files_to_load.items():

    file_path = os.path.join(
        data_path,
        file_name
    )

    if os.path.exists(file_path):

        df = pd.read_csv(file_path)

        df.columns = df.columns.str.upper()

        data[key] = df

        print(
            f"{file_name} loaded successfully - "
            f"{len(df)} records"
        )

    else:

        print(
            f"{file_name} not found"
        )


print("\nAvailable datasets:")
print(list(data.keys()))


# ============================================================
# 5. DISPLAY DATASET INFORMATION
# ============================================================

print("\n========== DATASET INFORMATION ==========")

for name, df in data.items():

    print("\nDataset:", name)

    print("Rows:", len(df))

    print("Columns:")

    print(df.columns.tolist())


# ============================================================
# 6. CREATE CLINICAL CONTEXT
# ============================================================

print("\nCreating clinical context...")

all_context = []


# ------------------------------------------------------------
# Patient + Admission Information
# ------------------------------------------------------------

for _, row in data["admissions"].iterrows():

    sid = row["SUBJECT_ID"]

    patient_rows = data["patients"][
        data["patients"]["SUBJECT_ID"] == sid
    ]

    if not patient_rows.empty:

        gender = patient_rows["GENDER"].values[0]

        dob = patient_rows["DOB"].values[0]

    else:

        gender = "Unknown"

        dob = "Unknown"


    text = (

        f"Patient {sid}. "

        f"Gender: {gender}. "

        f"Date of Birth: {dob}. "

        f"Admission Time: {row['ADMITTIME']}. "

        f"Diagnosis: {row['DIAGNOSIS']}. "

        f"Insurance: {row['INSURANCE']}. "

        f"Marital Status: {row['MARITAL_STATUS']}. "

        f"Admission Type: {row['ADMISSION_TYPE']}."

    )

    all_context.append(text)


# ------------------------------------------------------------
# Prescription Information
# ------------------------------------------------------------

for _, row in data["prescriptions"].iterrows():

    text = (

        f"Patient {row['SUBJECT_ID']} "

        f"was prescribed {row['DRUG']} "

        f"with dose {row['DOSE_VAL_RX']} "

        f"{row['DOSE_UNIT_RX']}."

    )

    all_context.append(text)


# ------------------------------------------------------------
# Diagnosis Information
# ------------------------------------------------------------

for _, row in data["diagnoses"].iterrows():

    text = (

        f"Patient {row['SUBJECT_ID']} "

        f"has diagnosis code "

        f"{row['ICD9_CODE']}."

    )

    all_context.append(text)


print(
    "\nTotal clinical context records:",
    len(all_context)
)


# ============================================================
# 7. CREATE SENTENCE TRANSFORMER EMBEDDINGS
# ============================================================

print("\nCreating embeddings...")

retriever_model = SentenceTransformer(
    "sentence-transformers/all-MiniLM-L6-v2"
)

embeddings = retriever_model.encode(

    all_context,

    show_progress_bar=True

)

embeddings = np.array(
    embeddings
).astype("float32")


print(
    "\nEmbedding shape:",
    embeddings.shape
)


# ============================================================
# 8. CREATE FAISS VECTOR DATABASE
# ============================================================

print("\nCreating FAISS index...")

dimension = embeddings.shape[1]

index = faiss.IndexFlatL2(
    dimension
)

index.add(
    embeddings
)

print(
    "FAISS index created successfully."
)

print(
    "Number of indexed records:",
    index.ntotal
)


# ============================================================
# 9. LOAD MISTRAL-7B MODEL
# ============================================================

print("\nLoading Mistral model...")

model_id = "mistralai/Mistral-7B-Instruct-v0.3"


bnb_config = BitsAndBytesConfig(

    load_in_4bit=True,

    bnb_4bit_use_double_quant=True,

    bnb_4bit_quant_type="nf4",

    bnb_4bit_compute_dtype=torch.bfloat16

)


tokenizer = AutoTokenizer.from_pretrained(
    model_id
)


model = AutoModelForCausalLM.from_pretrained(

    model_id,

    quantization_config=bnb_config,

    device_map="auto"

)


generator = pipeline(

    "text-generation",

    model=model,

    tokenizer=tokenizer,

    max_new_tokens=150

)


print(
    "Mistral model loaded successfully."
)


# ============================================================
# 10. RAG FUNCTION
# ============================================================

def run_rag(question):

    # --------------------------------------------------------
    # Convert question into embedding
    # --------------------------------------------------------

    question_embedding = retriever_model.encode(
        [question]
    )

    question_embedding = np.array(
        question_embedding
    ).astype("float32")


    # --------------------------------------------------------
    # Retrieve top 3 relevant clinical records
    # --------------------------------------------------------

    distances, indices = index.search(

        question_embedding,

        k=3

    )


    # --------------------------------------------------------
    # Combine retrieved context
    # --------------------------------------------------------

    context = "\n---\n".join(

        [
            all_context[i]
            for i in indices[0]
        ]

    )


    # --------------------------------------------------------
    # Create prompt
    # --------------------------------------------------------

    prompt = f"""

<s>[INST]

Use the following clinical records
to answer the question.

Clinical Context:

{context}

Question:

{question}

Answer only using the information
available in the clinical context.

[/INST]

"""


    # --------------------------------------------------------
    # Generate answer
    # --------------------------------------------------------

    output = generator(

        prompt,

        max_new_tokens=150,

        do_sample=False,

        pad_token_id=tokenizer.eos_token_id

    )


    answer = output[0][
        "generated_text"
    ]


    answer = answer.split(
        "[/INST]"
    )[-1].strip()


    return answer


# ============================================================
# 11. TEST RAG SYSTEM
# ============================================================

print("\n========== RAG TEST ==========")

test_question = (
    "What is the insurance information "
    "for the patient?"
)

answer = run_rag(
    test_question
)

print("\nQuestion:")
print(test_question)

print("\nGenerated Answer:")
print(answer)


# ============================================================
# 12. LOAD QUESTION DATASET
# ============================================================

question_file = (
    "/content/drive/My Drive/"
    "mimic_iii_qa_testset.csv"
)

if os.path.exists(question_file):

    questions_df = pd.read_csv(
        question_file
    )

    print(
        "\nQuestion dataset loaded."
    )

    print(
        "Number of questions:",
        len(questions_df)
    )

else:

    questions_df = None

    print(
        "\nQuestion dataset not found."
    )


# ============================================================
# 13. RUN RAG ON FIRST 25 QUESTIONS
# ============================================================

if questions_df is not None:

    results = []

    print(
        "\n========== RAG EVALUATION =========="
    )

    total_questions = min(
        25,
        len(questions_df)
    )


    for i in range(
        total_questions
    ):

        question = questions_df.iloc[i][
            "Question_Text"
        ]


        try:

            answer = run_rag(
                question
            )


            results.append({

                "ID": i,

                "Question": question,

                "Answer": answer

            })


            print(
                f"Processed "
                f"{i + 1}/{total_questions}"
            )


        except Exception as e:

            print(
                f"Error on question "
                f"{i + 1}: {e}"
            )


            results.append({

                "ID": i,

                "Question": question,

                "Answer": "Error"

            })


    results_df = pd.DataFrame(
        results
    )


    results_df.to_csv(

        "mimic_first_25_results.csv",

        index=False

    )


    print(
        "\nResults saved to:"
    )

    print(
        "mimic_first_25_results.csv"
    )


# ============================================================
# 14. LOAD DATA FOR EVALUATION
# ============================================================

patients = data["patients"]

admissions = data["admissions"]


# ============================================================
# 15. EVALUATION FUNCTION
# ============================================================

def evaluate_rag(

    results_df,

    patients_df,

    admissions_df

):

    metrics = []


    for _, row in results_df.iterrows():

        question = str(
            row["Question"]
        ).lower()


        answer = str(
            row["Answer"]
        ).lower()


        # ----------------------------------------------------
        # Find patient ID
        # ----------------------------------------------------

        sid_match = re.search(

            r"patient\s+(\d+)",

            answer

        )


        if not sid_match:

            continue


        sid = int(
            sid_match.group(1)
        )


        truth_value = ""


        # ----------------------------------------------------
        # Gender
        # ----------------------------------------------------

        if "gender" in question:

            values = patients_df[

                patients_df[
                    "SUBJECT_ID"
                ] == sid

            ]["GENDER"]


            if len(values) > 0:

                value = values.iloc[0]


                truth_value = (

                    "male"

                    if value == "M"

                    else "female"

                )


        # ----------------------------------------------------
        # Insurance
        # ----------------------------------------------------

        elif "insurance" in question:

            values = admissions_df[

                admissions_df[
                    "SUBJECT_ID"
                ] == sid

            ]["INSURANCE"]


            if len(values) > 0:

                truth_value = str(

                    values.iloc[0]

                ).lower()


        # ----------------------------------------------------
        # Ethnicity
        # ----------------------------------------------------

        elif "ethnicity" in question:

            values = admissions_df[

                admissions_df[
                    "SUBJECT_ID"
                ] == sid

            ]["ETHNICITY"]


            if len(values) > 0:

                truth_value = str(

                    values.iloc[0]

                ).lower()


        # ----------------------------------------------------
        # Marital Status
        # ----------------------------------------------------

        elif "marital status" in question:

            values = admissions_df[

                admissions_df[
                    "SUBJECT_ID"
                ] == sid

            ]["MARITAL_STATUS"]


            if len(values) > 0:

                truth_value = str(

                    values.iloc[0]

                ).lower()


        # ----------------------------------------------------
        # Admission Type
        # ----------------------------------------------------

        elif "admission type" in question:

            values = admissions_df[

                admissions_df[
                    "SUBJECT_ID"
                ] == sid

            ]["ADMISSION_TYPE"]


            if len(values) > 0:

                truth_value = str(

                    values.iloc[0]

                ).lower()


        # ----------------------------------------------------
        # Check correctness
        # ----------------------------------------------------

        correct = (

            1

            if truth_value in answer

            else 0

        )


        precision = (

            1.0

            if correct

            else 0.0

        )


        recall = (

            1.0

            if correct

            else 0.0

        )


        if precision + recall > 0:

            f1 = (

                2
                * precision
                * recall

            ) / (

                precision
                + recall

            )

        else:

            f1 = 0


        metrics.append({

            "Question":
            row["Question"],

            "Truth":
            truth_value,

            "Correct":
            correct,

            "Precision":
            precision,

            "Recall":
            recall,

            "F1":
            f1

        })


    return pd.DataFrame(
        metrics
    )


# ============================================================
# 16. CALCULATE FINAL METRICS
# ============================================================

if "results_df" in globals():

    eval_results = evaluate_rag(

        results_df,

        patients,

        admissions

    )


    if len(eval_results) > 0:

        accuracy = (
            eval_results["Correct"].mean()
        )

        precision = (
            eval_results["Precision"].mean()
        )

        recall = (
            eval_results["Recall"].mean()
        )

        f1 = (
            eval_results["F1"].mean()
        )


        print(
            "\n========== FINAL METRICS =========="
        )


        print(
            "Accuracy :",
            f"{accuracy:.2%}"
        )


        print(
            "Precision:",
            f"{precision:.2f}"
        )


        print(
            "Recall   :",
            f"{recall:.2f}"
        )


        print(
            "F1 Score :",
            f"{f1:.2f}"
        )


# ============================================================
# 17. PERFORMANCE GRAPH
# ============================================================

if "eval_results" in globals():

    labels = [

        "Accuracy",

        "Precision",

        "Recall",

        "F1 Score"

    ]


    values = [

        eval_results[
            "Correct"
        ].mean(),

        eval_results[
            "Precision"
        ].mean(),

        eval_results[
            "Recall"
        ].mean(),

        eval_results[
            "F1"
        ].mean()

    ]


    plt.figure(
        figsize=(10, 6)
    )


    plt.bar(
        labels,
        values
    )


    plt.ylim(
        0,
        1.1
    )


    plt.title(
        "Clinical RAG System Performance"
    )


    plt.ylabel(
        "Score"
    )


    for i, value in enumerate(
        values
    ):

        plt.text(

            i,

            value + 0.02,

            f"{value:.2f}",

            ha="center"

        )


    plt.show()


# ============================================================
# END OF CLINICAL GenAI RAG SYSTEM
# ============================================================

print(
    "\nClinical GenAI RAG pipeline completed."
)
