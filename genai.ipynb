# 3. IMPORT LIBRARIES
import os
import pandas as pd
import numpy as np
import torch
import faiss

from sentence_transformers import SentenceTransformer
from transformers import (
    AutoTokenizer,
    AutoModelForCausalLM,
    pipeline,
    BitsAndBytesConfig
)

print("Libraries imported successfully.")


# 4. LOAD CLINICAL DATA
print("Loading clinical data...")

files_to_load = {
    'patients': 'PATIENTS.csv',
    'admissions': 'ADMISSIONS.csv',
    'prescriptions': 'PRESCRIPTIONS.csv',
    'diagnoses': 'DIAGNOSES_ICD.csv',
    'labevents': 'LABEVENTS.csv'
}

data = {}

for key, file_name in files_to_load.items():
    if os.path.exists(file_name):
        df = pd.read_csv(file_name)
        df.columns = df.columns.str.upper()
        data[key] = df
        print(f"Loaded: {file_name}")

print("Available datasets:", list(data.keys()))


# 5. CREATE UNIFIED CLINICAL CONTEXT
all_context = []

# Merge patient and admission information
for _, row in data['admissions'].iterrows():
    sid = row['SUBJECT_ID']

    patient_rows = data['patients'][
        data['patients']['SUBJECT_ID'] == sid
    ]

    gender = (
        patient_rows['GENDER'].values[0]
        if not patient_rows.empty else "Unknown"
    )

    dob = (
        patient_rows['DOB'].values[0]
        if not patient_rows.empty else "Unknown"
    )

    text = (
        f"Patient {sid}: Gender {gender}, DOB {dob}. "
        f"Admitted on {row['ADMITTIME']} for {row['DIAGNOSIS']} "
        f"with {row['INSURANCE']} insurance. "
        f"Status: {row['MARITAL_STATUS']}. "
        f"Admission Type: {row['ADMISSION_TYPE']}."
    )

    all_context.append(text)

# Add prescription information
for _, row in data['prescriptions'].iterrows():
    all_context.append(
        f"Patient {row['SUBJECT_ID']} was prescribed "
        f"{row['DRUG']} ({row['DOSE_VAL_RX']} {row['DOSE_UNIT_RX']})."
    )

# Add diagnosis information
for _, row in data['diagnoses'].iterrows():
    all_context.append(
        f"Patient {row['SUBJECT_ID']} has a diagnosis code "
        f"{row['ICD9_CODE']}."
    )

print(f"Created {len(all_context)} clinical context snippets.")


# 6. CREATE BERT EMBEDDINGS AND FAISS INDEX
print("Creating embeddings...")

retriever_model = SentenceTransformer(
    'sentence-transformers/all-MiniLM-L6-v2'
)

embeddings = retriever_model.encode(
    all_context,
    show_progress_bar=True
)

index = faiss.IndexFlatL2(embeddings.shape[1])
index.add(np.array(embeddings).astype('float32'))

print("FAISS index created successfully.")
print("Number of indexed records:", index.ntotal)


# 7. LOAD MISTRAL-7B IN 4-BIT MODE
model_id = "mistralai/Mistral-7B-Instruct-v0.3"

bnb_config = BitsAndBytesConfig(
    load_in_4bit=True,
    bnb_4bit_use_double_quant=True,
    bnb_4bit_quant_type="nf4",
    bnb_4bit_compute_dtype=torch.bfloat16
)

tokenizer = AutoTokenizer.from_pretrained(model_id)

model = AutoModelForCausalLM.from_pretrained(
    model_id,
    quantization_config=bnb_config,
    device_map="auto"
)

generator = pipeline(
    "text-generation",
    model=model,
    tokenizer=tokenizer,
    max_new_tokens=150
)

print("Mistral model loaded successfully.")


# 8. RAG FUNCTION
def run_rag(question):
    # Convert the question into an embedding
    q_vec = retriever_model.encode([question])

    # Retrieve the top 3 relevant clinical records
    _, indices = index.search(
        np.array(q_vec).astype('float32'),
        k=3
    )

    context = "\n---\n".join(
        [all_context[i] for i in indices[0]]
    )

    # Create the prompt
    prompt = (
        "<s>[INST] Use the following clinical records to answer "
        "the question.\n\n"
        f"Context:\n{context}\n\n"
        f"Question: {question} [/INST]"
    )

    # Generate answer
    output = generator(
        prompt,
        max_new_tokens=150,
        do_sample=False,
        pad_token_id=tokenizer.eos_token_id
    )

    answer = output[0]['generated_text'].split("[/INST]")[-1].strip()

    return answer


# 9. TEST THE RAG SYSTEM
test_question = "What is the insurance information for the patient?"

answer = run_rag(test_question)

print("Question:", test_question)
print("Answer:", answer)


# 10. RUN RAG ON THE FIRST 25 QUESTIONS
questions_df = pd.read_csv(
    '/content/drive/My Drive/mimic_iii_qa_testset.csv'
)

results = []

print("Starting processing for the first 25 questions...")

for i in range(25):
    question = questions_df.iloc[i]['Question_Text']

    try:
        answer = run_rag(question)

        results.append({
            "ID": i,
            "Question": question,
            "Answer": answer
        })

        print(f"Processed {i + 1}/25")

    except Exception as e:
        print(f"Error on Q{i + 1}: {e}")

        results.append({
            "ID": i,
            "Question": question,
            "Answer": "Error"
        })

final_results = pd.DataFrame(results)

final_results.to_csv(
    'mimic_first_25_results.csv',
    index=False
)

print("Results saved to mimic_first_25_results.csv")


# 11. EVALUATE FACTUAL ACCURACY
import re

results_df = pd.read_csv('mimic_first_25_results.csv')

patients = pd.read_csv('PATIENTS.csv')
admissions = pd.read_csv('ADMISSIONS.csv')

patients.columns = patients.columns.str.upper()
admissions.columns = admissions.columns.str.upper()


def evaluate_rag(results_df, patients_df, admissions_df):
    metrics = []

    for _, row in results_df.iterrows():
        question = row['Question'].lower()
        answer = str(row['Answer']).lower()

        sid_match = re.search(r'patient (\d+)', answer)

        if not sid_match:
            continue

        sid = int(sid_match.group(1))
        truth_value = ""

        if "gender" in question:
            value = patients_df[
                patients_df['SUBJECT_ID'] == sid
            ]['GENDER'].iloc[0]

            truth_value = (
                "male" if value == "M" else "female"
            )

        elif "insurance" in question:
            truth_value = str(
                admissions_df[
                    admissions_df['SUBJECT_ID'] == sid
                ]['INSURANCE'].iloc[0]
            ).lower()

        elif "ethnicity" in question:
            truth_value = str(
                admissions_df[
                    admissions_df['SUBJECT_ID'] == sid
                ]['ETHNICITY'].iloc[0]
            ).lower()

        elif "marital status" in question:
            truth_value = str(
                admissions_df[
                    admissions_df['SUBJECT_ID'] == sid
                ]['MARITAL_STATUS'].iloc[0]
            ).lower()

        elif "admission type" in question:
            truth_value = str(
                admissions_df[
                    admissions_df['SUBJECT_ID'] == sid
                ]['ADMISSION_TYPE'].iloc[0]
            ).lower()

        is_correct = 1 if truth_value in answer else 0

        precision = 1.0 if is_correct else 0.0
        recall = 1.0 if is_correct else 0.0

        f1 = (
            (2 * precision * recall) / (precision + recall)
            if precision + recall > 0 else 0
        )

        metrics.append({
            'Question': row['Question'],
            'Truth': truth_value,
            'Correct': is_correct,
            'Precision': precision,
            'Recall': recall,
            'F1': f1
        })

    return pd.DataFrame(metrics)


eval_results = evaluate_rag(
    results_df,
    patients,
    admissions
)

print("--- Final Metrics ---")
print(f"Accuracy:  {eval_results['Correct'].mean():.2%}")
print(f"Precision: {eval_results['Precision'].mean():.2f}")
print(f"F1-Score:  {eval_results['F1'].mean():.2f}")

eval_results[['Question', 'Truth', 'Correct']].head(10)


# 12. PERFORMANCE SUMMARY
import matplotlib.pyplot as plt

labels = ['Accuracy', 'Precision', 'F1-Score']

values = [
    eval_results['Correct'].mean(),
    eval_results['Precision'].mean(),
    eval_results['F1'].mean()
]

plt.figure(figsize=(10, 6))
plt.bar(labels, values)

plt.ylim(0, 1.1)
plt.title('Clinical RAG System Performance Summary')
plt.ylabel('Score (0.0 to 1.0)')

for i, value in enumerate(values):
    label = f"{value:.2%}" if i == 0 else f"{value:.2f}"
    plt.text(i, value + 0.02, label, ha='center')

plt.show()
